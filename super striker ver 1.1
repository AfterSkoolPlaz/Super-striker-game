 pc.ondatachannel=e=>{const dc=e.channel;NET.dc=dc;dc.onopen=()=>{NET.role='c';dc.send(JSON.stringify({t:'hello',n:$('pn').value}));$('jst').textContent='Connected ✅ Waiting for the host to start…'};dc.onmessage=e=>onMsg(0,JSON.parse(e.data));dc.onclose=()=>{$('msg').textContent='Host disconnected'}};
 r.on('sig',async m=>{const d=m.data;if(m.isMe||!d||d.g!=g||d.k!='offer')return;await pc.setRemoteDescription(d.d);await pc.setLocalDescription(await pc.createAnswer());await gathered(pc);const ld=pc.localDescription;r.emit('sig',{k:'answer',g,d:{type:ld.type,sdp:ld.sdp}}).catch(()=>{})});
 let n=0;const hi=()=>{if(NET.role=='c'||n++>12)return;r.emit('sig',{k:'hi',g,n:$('pn').value}).catch(()=>{$('jst').textContent='Not allowed to send — ask the host for Contributor access, or use a manual code'});setTimeout(hi,2500)};hi();return true}
const _cp=closePeers;closePeers=function(){_cp();if(SIG){try{SIG.leave()}catch(e){}SIG=null}};
function pg(id){document.querySelectorAll('#mp .pg').forEach(x=>x.style.display=x.id==id?'block':'none');$('mp').classList.add('on')}
$('battle').onclick=()=>pg('p_mode');$('lset').onclick=()=>openSet();
$('m44').onclick=()=>{NET.role='solo';$('mp').classList.remove('on');$('lobby').classList.remove('on');$('go').onclick()};
$('mcu').onclick=()=>pg('p_menu');$('mc').onclick=()=>{NET.role='h';pg('p_host');renderRoom();const f=()=>{$('rcw').style.display='none';$('rmsg').textContent='Quick codes unavailable here — use the manual invite below.'};$('rmsg').textContent='Creating room…';startSig().then(ok=>{if(!ok)return f();$('rcw').style.display='block';$('rmsg').textContent='Friends: BATTLE → CUSTOM → JOIN ROOM → enter this code.'}).catch(f)};$('mj').onclick=()=>pg('p_join');
$('addp').onclick=hostInvite;$('acb').onclick=hostAccept;$('jgo').onclick=guestJoin;
$('jjoin').onclick=async()=>{const c=$('jn').value.replace(/\D/g,'');if(c.length!=6){$('jst').textContent='Enter a 6-digit code';return}$('jst').textContent='Connecting…';try{if(!await guestSig(c))$('jst').textContent='Quick codes unavailable — use a manual code below'}catch(e){$('jst').textContent='Could not join. Check the code or use a manual code.'}};
$('stm').onclick=()=>{hostStart();$('mp').classList.remove('on');$('lobby').classList.remove('on');$('go').onclick()};
document.querySelectorAll('.bk').forEach(b=>b.onclick=()=>{const t=b.dataset.to;if(t=='x')$('mp').classList.remove('on');else pg(t);if(t=='p_menu'||t=='x'){NET.role='solo';closePeers()}});
// settings, fullscreen, button layout
let SENS=1,BSZ=1,EDIT=false,LAY={},dr=null,sprev=null;const BT=['bf','bj','br','bb','bs','bz','bg'];
function fsOn(){const d=document.documentElement,f=d.requestFullscreen||d.webkitRequestFullscreen;if(f&&!document.fullscreenElement&&!document.webkitFullscreenElement){try{const p=f.call(d);if(p&&p.catch)p.catch(()=>{})}catch(e){}}}
function fs(){if(document.fullscreenElement||document.webkitFullscreenElement){const x=document.exitFullscreen||document.webkitExitFullscreen;try{x.call(document)}catch(e){}}else fsOn()}
try{LAY=JSON.parse(localStorage.getItem('sa_lay')||'{}');const s=JSON.parse(localStorage.getItem('sa_set')||'{}');if(s.sens)SENS=s.sens;if(s.bsz)BSZ=s.bsz}catch(e){}
function save(){try{localStorage.setItem('sa_lay',JSON.stringify(LAY));localStorage.setItem('sa_set',JSON.stringify({sens:SENS,bsz:BSZ}))}catch(e){}}
function applyLay(){BT.forEach(id=>{const el=$(id),b=LAY[id];el.style.transform='scale('+BSZ+')';if(b){el.style.left=Math.max(0,Math.min(b.x*innerWidth,innerWidth-50))+'px';el.style.top=Math.max(0,Math.min(b.y*innerHeight,innerHeight-50))+'px';el.style.right=el.style.bottom='auto'}})}
function lab(){$('svl').textContent=SENS.toFixed(1);$('bvl').textContent=BSZ.toFixed(1)}
function openSet(){if(sprev===null){sprev=state;if(state=='play'){state='pause';document.exitPointerLock()}}$('sv').value=SENS;$('bv').value=BSZ;lab();$('set').classList.add('on')}
function closeSet(){$('set').classList.remove('on');save();const p=sprev;sprev=null;if(p=='play')lock()}
$('bgr').onclick=openSet;$('bfs').onclick=fs;$('sbtn').onclick=openSet;$('ps').onclick=openSet;$('scl').onclick=closeSet;$('sfs').onclick=fs;
$('sv').oninput=e=>{SENS=+e.target.value;lab();save()};$('bv').oninput=e=>{BSZ=+e.target.value;applyLay();lab();save()};
$('tools').addEventListener('mousedown',e=>e.stopPropagation());
$('ebtn').onclick=()=>{$('set').classList.remove('on');EDIT=true;document.body.classList.add('ed')};
$('edone').onclick=()=>{EDIT=false;dr=null;document.body.classList.remove('ed');save();$('set').classList.add('on')};
$('ereset').onclick=()=>{LAY={};BT.forEach(id=>{const el=$(id);el.style.left=el.style.top=el.style.right=el.style.bottom=''});applyLay();save()};
const tcE=$('tc');
tcE.addEventListener('touchstart',e=>{if(!EDIT)return;e.preventDefault();e.stopPropagation();const t=e.changedTouches[0],el=t.target.closest&&t.target.closest('.tb');if(el&&!dr)dr={el,id:t.identifier,dx:t.clientX-el.offsetLeft,dy:t.clientY-el.offsetTop}},{capture:true,passive:false});
tcE.addEventListener('touchmove',e=>{if(!EDIT)return;e.preventDefault();e.stopPropagation();if(!dr)return;for(const t of e.changedTouches)if(t.identifier===dr.id){const x=Math.max(0,Math.min(innerWidth-60,t.clientX-dr.dx)),y=Math.max(0,Math.min(innerHeight-60,t.clientY-dr.dy));dr.el.style.left=x+'px';dr.el.style.top=y+'px';dr.el.style.right=dr.el.style.bottom='auto';LAY[dr.el.id]={x:x/innerWidth,y:y/innerHeight}}},{capture:true,passive:false});
['touchend','touchcancel'].forEach(n=>tcE.addEventListener(n,e=>{if(!EDIT)return;e.preventDefault();e.stopPropagation();dr=null;save()},{capture:true,passive:false}));
addEventListener('resize',applyLay);applyLay();
// ===== extras: admin panel, grenades, rockets, minimap =====
let mmOn=true,freeMouse=false,aimLock=false;
function openAdmin(){if(state!='play')return;state='admin';md=0;zoom=0;document.exitPointerLock();$('amsg').textContent='';$('admc').value='';$('adm').classList.add('on');setTimeout(()=>$('admc').focus(),30)}
function closeAdmin(){$('adm').classList.remove('on');$('admc').blur();lock()}
function flash(t){$('msg').textContent=t;setTimeout(()=>{if($('msg').textContent==t)$('msg').textContent=''},2200)}
function adminSubmit(){const c=$('admc').value.trim().toUpperCase();
 if(c==='BRO'){inv.rpg={m:1,res:999};cur='rpg';relT=0;fireT=.2;setHUD();closeAdmin();flash('RPG UNLOCKED — INFINITE AMMO')}
 else if(c==='AIM'){aimLock=!aimLock;closeAdmin();flash(aimLock?'AIM LOCK ON':'AIM LOCK OFF')}
 else{$('amsg').textContent='✖ Invalid code';$('admc').value=''}}
$('aok').onclick=adminSubmit;$('acl').onclick=closeAdmin;$('bad').onclick=openAdmin;
$('admc').addEventListener('keydown',e=>{e.stopPropagation();if(e.key=='Enter')adminSubmit();if(e.key=='Escape')closeAdmin()});
const rockets=[],nades=[],fxs=[];
const rgeo=new T.CylinderGeometry(.1,.1,.8,8),ggeo=new T.SphereGeometry(.18,10,8),egeo=new T.SphereGeometry(1,14,10);
function boom(p,Rd,maxD,col){const m=new T.Mesh(egeo,new T.MeshBasicMaterial({color:col,transparent:true,opacity:.85}));m.position.copy(p);scene.add(m);fxs.push({m,t:0,R:Rd});sfx(60,.5,.15,'sawtooth');let any=false;
 for(const e of ents){if(!e.alive||e.team==P.team||e===P)continue;const dist=Math.hypot(e.x-p.x,(e.y||0)+.9-p.y,e.z-p.z);if(dist<Rd){hit(e,Math.round(maxD*(1-.6*dist/Rd)));any=true}}
 if(any){$('hit').style.opacity=1;$('hit').style.borderColor='#fff';setTimeout(()=>$('hit').style.opacity=0,120)}}
function launchRocket(){const d=new T.Vector3();cam.getWorldDirection(d);const m=new T.Mesh(rgeo,mat(0x888888));m.position.copy(cam.position).addScaledVector(d,1.2);m.position.y-=.15;m.quaternion.setFromUnitVectors(new T.Vector3(0,1,0),d);scene.add(m);rockets.push({m,v:d.multiplyScalar(45),life:4});sfx(70,.35,.1,'sawtooth');vm.position.z=-.3}
function throwNade(){if(state!='play'||grenades<=0||!P.alive)return;grenades--;const d=new T.Vector3();cam.getWorldDirection(d);const m=new T.Mesh(ggeo,mat(0x2e4d2e));m.position.copy(cam.position).addScaledVector(d,.8);scene.add(m);nades.push({m,v:d.clone().multiplyScalar(16).add(new T.Vector3(0,4,0)),t:2.2});sfx(300,.1,.05);setHUD()}
function stepProj(dt){
 for(let i=rockets.length-1;i>=0;i--){const r=rockets[i];let dead=false;r.life-=dt;
  for(let k=0;k<4&&!dead;k++){r.m.position.addScaledVector(r.v,dt/4);const p=r.m.position;
   if(p.y<=0||(hitObs(p.x,p.z,0)&&p.y<7)||Math.abs(p.x)>50||Math.abs(p.z)>50)dead=true;
   else for(const e of ents)if(e.alive&&e.team!=P.team&&Math.hypot(e.x-p.x,e.z-p.z)<.8&&p.y<2.1+(e.y||0)){dead=true;break}}
  if(dead||r.life<=0){r.m.position.y=Math.max(.3,r.m.position.y);boom(r.m.position,8,130,0xff8a2a);scene.remove(r.m);rockets.splice(i,1)}}
 for(let i=nades.length-1;i>=0;i--){const n=nades[i],p=n.m.position;n.t-=dt;n.v.y-=20*dt;
  const nx=p.x+n.v.x*dt,nz=p.z+n.v.z*dt;if(hitObs(nx,p.z,.15)||Math.abs(nx)>49.5)n.v.x*=-.5;else p.x=nx;if(hitObs(p.x,nz,.15)||Math.abs(nz)>49.5)n.v.z*=-.5;else p.z=nz;
  p.y+=n.v.y*dt;if(p.y<.18){p.y=.18;if(n.v.y<0)n.v.y*=-.4;n.v.x*=.8;n.v.z*=.8}
  if(n.t<=0){boom(p,9,110,0xffb030);scene.remove(n.m);nades.splice(i,1)}}
 for(let i=fxs.length-1;i>=0;i--){const f=fxs[i];f.t+=dt;f.m.scale.setScalar(Math.max(.1,f.R*Math.min(1,f.t/.25)));f.m.material.opacity=Math.max(0,.85*(1-f.t/.5));if(f.t>.5){scene.remove(f.m);fxs.splice(i,1)}}}
const mmc=$('mm'),mx=mmc.getContext('2d');
function drawMap(){mmc.style.display=mmOn?'block':'none';if(!mmOn)return;const S=150,k=S/100,X=x=>(x+50)*k;mx.clearRect(0,0,S,S);
 mx.fillStyle='rgba(60,100,50,.55)';mx.fillRect(0,0,S,S);mx.fillStyle='rgba(200,190,170,.85)';
 for(const o of obs){if(o.w>=40||o.d>=40)continue;mx.fillRect(X(o.x-o.w/2),X(o.z-o.d/2),Math.max(1.5,o.w*k),Math.max(1.5,o.d*k))}
 for(const e of ents){if(e===P||!e.alive)continue;const en=e.team!=P.team;mx.fillStyle=en?'#ff4d5a':'#3b9bff';mx.beginPath();mx.arc(X(e.x),X(e.z),en?3.5:2.5,0,6.283);mx.fill();if(en){mx.strokeStyle='#fff';mx.lineWidth=1;mx.stroke()}}
 const px=X(P.x),py=X(P.z),fx=-Math.sin(P.yaw),fz=-Math.cos(P.yaw);
 mx.fillStyle='#ffd23d';mx.strokeStyle='#000';mx.lineWidth=1;mx.beginPath();mx.moveTo(px+fx*8,py+fz*8);mx.lineTo(px-fx*4-fz*4.5,py-fz*4+fx*4.5);mx.lineTo(px-fx*4+fz*4.5,py-fz*4-fx*4.5);mx.closePath();mx.fill();mx.stroke()}
// loop
let last=performance.now();
function loop(now){requestAnimationFrame(loop);const dt=Math.min(.05,(now-last)/1000);last=now;
 if(state=='menu'){cam.position.set(Math.sin(now/4000)*40,14,Math.cos(now/4000)*40);cam.lookAt(0,0,0);renderer.render(scene,cam);return}
 if(state=='pause'){renderer.render(scene,cam);return}
 fireT-=dt;
 if(relT>0){relT-=dt;if(relT<=0){const s=inv[cur],w=W[cur],n=Math.min(w.m-s.m,s.res);s.m+=n;s.res-=n;relT=0;setHUD()}}
 if(P.alive){const sp=(K.ShiftLeft?7:4.5)*dt;let f=(K.KeyW?1:0)-(K.KeyS?1:0)-JY,s=(K.KeyD?1:0)-(K.KeyA?1:0)+JX;const l=Math.max(1,Math.hypot(f,s));f/=l;s/=l;
  const sn=Math.sin(P.yaw),cs=Math.cos(P.yaw);move(P,(-sn*f+cs*s)*sp,(-cs*f-sn*s)*sp);
  if(K.Space&&P.y==0){P.vy=7}P.y=P.y||0;P.vy-=20*dt;P.y=Math.max(0,P.y+P.vy*dt);if(P.y==0&&P.vy<0)P.vy=0;
  if(md&&(W[cur].a||!P.held)){shoot();P.held=!W[cur].a}if(!md)P.held=false;
  if(inv[cur]&&state=='play'&&md&&!W[cur].a&&fireT<=0){}}
 else{P.t-=dt;if(P.t<=0){respawn(P);P.vy=0;P.y=0;$('msg').textContent='';setHUD()}}
 if(aimLock&&P.alive&&state=='play'){let b=null,bd=1e9;const ey=1.7+(P.y||0);for(const e of ents){if(!e.alive||e.team==P.team)continue;const d=Math.hypot(e.x-P.x,e.z-P.z);if(d<bd&&d<90&&los(P,e)){bd=d;b=e}}
  if(b){const dx=b.x-P.x,dz=b.z-P.z,dy=1.45+(b.y||0)-ey,ty=Math.atan2(-dx,-dz),tp2=Math.atan2(dy,Math.hypot(dx,dz));let df=ty-P.yaw;df=Math.atan2(Math.sin(df),Math.cos(df));P.yaw+=df*.35;P.pitch+=(tp2-P.pitch)*.35}}
 cam.position.set(P.x,1.7+(P.y||0),P.z);cam.rotation.set(P.pitch,P.yaw,0,'YXZ');
 const fv=zoom&&cur=='sniper'?25:zoom?55:75;cam.fov+=(fv-cam.fov)*.2;cam.updateProjectionMatrix();vm.visible=!(zoom&&cur=='sniper');vm.position.z+=(-.5-vm.position.z)*.2;
 // network sync
 if(NET.role=='c'&&NET.dc&&NET.dc.readyState=='open'){NET.t-=dt;if(NET.t<=0){NET.t=.05;NET.dc.send(JSON.stringify({t:'st',x:+P.x.toFixed(2),z:+P.z.toFixed(2),y:+(P.y||0).toFixed(2),w:+(P.yaw+Math.PI).toFixed(2)}))}}
 if(NET.role=='h'&&NET.go){NET.t-=dt;if(NET.t<=0){NET.t=.066;bc({t:'snap',s:[score.b,score.r],e:ents.map(e=>[e.id,+e.x.toFixed(2),+e.z.toFixed(2),+(e.isP?P.yaw+Math.PI:e.rem?(e.yw||0):e.g.rotation.y).toFixed(2),Math.round(e.hp),e.alive?1:0,+((e.isP?P.y:e.y)||0).toFixed(2)])})}}
 for(const e of ents){if(!e.rem||e===P)continue;
  if(NET.role=='h'&&!e.alive){e.t-=dt;if(e.t<=0){respawn(e);e.tx=e.x;e.tz=e.z}}
  const k=Math.min(1,dt*12);if(e.tx!=null){e.x+=(e.tx-e.x)*k;e.z+=(e.tz-e.z)*k}
  e.g.visible=e.alive;e.g.rotation.y=e.yw||0;const mv=Math.hypot(e.x-(e.px||e.x),e.z-(e.pz||e.z))>.003;e.px=e.x;e.pz=e.z;e.wk=(e.wk||0)+(mv?dt*10:0);e.lg[0].rotation.x=mv?Math.sin(e.wk)*.7:0;e.lg[1].rotation.x=mv?-Math.sin(e.wk)*.7:0;e.g.position.set(e.x,e.y||0,e.z)}
 // bots
 for(const e of ents){if(e.isP||e.rem)continue;
  if(!e.alive){e.t-=dt;if(e.t<=0)respawn(e);continue}
  e.cd-=dt;e.rt=(e.rt||0)-dt;
  if(e.rt<=0){e.rt=.4;let b=null,bd=1e9;for(const o of ents)if(o.alive&&o.team!=e.team){const d=Math.hypot(o.x-e.x,o.z-e.z);if(d<bd){bd=d;b=o}}e.near=b;e.nd=bd;e.see=b&&bd<55&&los(e,b)}
  const o=e.near;if(!o)continue;const dx=o.x-e.x,dz=o.z-e.z,d=Math.hypot(dx,dz)||1,sp=3.6*dt;
  e.g.rotation.y=Math.atan2(dx,dz);e.ph+=dt;
  if(e.see){const st=Math.sin(e.ph*1.6)*sp,nx=dx/d,nz=dz/d;let fw=d>20?sp:d<9?-sp:0;move(e,nx*fw-nz*st,nz*fw+nx*st);
   if(e.cd<=0){e.cd=.35+R()*.35;const p=Math.max(.08,.5-d/110);const a=new T.Vector3(e.x,1.2,e.z),bb=new T.Vector3(o.x,1.2,o.z);
    if(d<25)sfx(160,.1,.012);const hit=R()<p;if(hit)damage(o,e,10+R()*6);tracer(a,hit?bb:bb.add(new T.Vector3(R()*3-1.5,0,R()*3-1.5)),e.team=='b'?0x6aaaff:0xff7a7a)}}
  else{const t=Math.atan2(dx,dz)+Math.sin(e.ph*.5)*.6;move(e,Math.sin(t)*sp,Math.cos(t)*sp)}
  const mv=Math.hypot(e.x-(e.px||e.x),e.z-(e.pz||e.z))>.003;e.px=e.x;e.pz=e.z;e.wk=(e.wk||0)+(mv?dt*10:0);e.lg[0].rotation.x=mv?Math.sin(e.wk)*.7:0;e.lg[1].rotation.x=mv?-Math.sin(e.wk)*.7:0;e.g.position.set(e.x,0,e.z)}
 for(let i=tr.length-1;i>=0;i--){tr[i].t-=dt;if(tr[i].t<=0){scene.remove(tr[i].l);trP.push(tr[i].l);tr.splice(i,1)}}
 stepProj(dt);drawMap();renderer.render(scene,cam)}
requestAnimationFrame(loop);
</script>
